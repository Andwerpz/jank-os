#include "globals.jank";
#include "memory/pma.jank";
#include "arch/pagetable.jank";
#include "arch/portio.jank";
#include "arch/apic.jank";
#include "utils/print.jank";
#include "sched/scheduler.jank";
#include "sched/process.jank";

//https://wiki.osdev.org/Interrupt_Descriptor_Table

[__GLOBAL_FIRST__] u8 IST_ATTR_PRESENT          = $u8 0b10000000;   //must be set
[__GLOBAL_FIRST__] u8 IST_ATTR_DPL_KERNEL       = $u8 0b00000000;   //only kernel can directly invoke via 'int' 
[__GLOBAL_FIRST__] u8 IST_ATTR_DPL_USER         = $u8 0b01100000;   //user can directly invoke via 'int'
[__GLOBAL_FIRST__] u8 IST_ATTR_INTERRUPT_GATE   = $u8 0b00001110;   //marks as interrupt gate, will auto clear IF flags on entry
[__GLOBAL_FIRST__] u8 IST_ATTR_TRAP_GATE        = $u8 0b00001111;   //marks as trap gate, will not clear IF flags on entry

struct IDTPointer {
    u16 limit;
    u64 base;
}

struct IDTEntry {
   u16 offset_1;        // offset bits 0..15
   u16 selector;        // a code segment selector in GDT or LDT
   u8  ist;             // bits 0..2 holds Interrupt Stack Table offset, rest of bits zero.
   u8  type_attr;       // gate type, dpl, and p fields
   u16 offset_2;        // offset bits 16..31
   u32 offset_3;        // offset bits 32..63
   u32 zero;            // reserved
}

IDTEntry* IDT;
IDTPointer* IDT_PTR;

//CPU exception : 0x00 - 0x1F
[__GLOBAL_FIRST__] u64 INTVEC_DIVIDE_ERROR          = 0x00;
[__GLOBAL_FIRST__] u64 INTVEC_INVALID_OPCODE        = 0x06;
[__GLOBAL_FIRST__] u64 INTVEC_INVALID_TSS           = 0x0A;
[__GLOBAL_FIRST__] u64 INTVEC_GENERAL_PROTECTION    = 0x0D;
[__GLOBAL_FIRST__] u64 INTVEC_PAGE_FAULT            = 0x0E;

//PIC interrupts : 0x20 - 0x2F
[__GLOBAL_FIRST__] u64 INTVEC_PIT                   = 0x20;
[__GLOBAL_FIRST__] u64 INTVEC_PS2                   = 0x21;
[__GLOBAL_FIRST__] u64 INTVEC_E1000;

//APIC interrupts : 0x30 - 0xEF
[__GLOBAL_FIRST__] u64 INTVEC_XHCI                  = 0x30;
[__GLOBAL_FIRST__] u64 INTVEC_RTL8111               = 0x31;

//Reserved interrupts (?) : 0xF0 - 0xFF
[__GLOBAL_FIRST__] u64 INTVEC_SPURIOUS              = 0xFF;     // accidental interrupts arriving from APIC due to electrical faults (?)

// Interrupt ReQuest Handler
struct IRQHandler {
    i32 present;
    fn<void(void*)> handler;
    void* data;     // context for handler
}
u64 IRQ_HANDLER_AMT = $u64 0x100;   // 0x00 to 0xFF
IRQHandler* IRQ_HANDLERS;

// provided by idt_stubs.s
extern u8 interrupt_stub_table;

i32 init_idt() {
    println("start init idt");
    pagetable_t kernel_pt = pt_get_current();

    //alloc array for IRQ handlers
    IRQ_HANDLERS = $IRQHandler* malloc(sizeof(IRQHandler) * IRQ_HANDLER_AMT);
    for(u64 i = 0x0; i < IRQ_HANDLER_AMT; i++) {
        IRQ_HANDLERS[i].present = 0;
        IRQ_HANDLERS[i].data = nullptr;
    }

    //map page for IDT
    pt_map_page(kernel_pt, $void* IDT_PAGE, palloc(), PTE_WRITEABLE);
    memset($void* IDT_PAGE, 0, PAGE_SIZE);  //clear page
    IDT = $IDTEntry* IDT_PAGE;

    //create IDTPointer
    IDT_PTR = $IDTPointer* malloc(sizeof(IDTPointer));
    IDT_PTR->limit = $u16 sizeof(IDTEntry) * $u16 256 - $u16 1;
    IDT_PTR->base = $u64 IDT;    

    //map CPU exceptions
    idt_set_entry(INTVEC_GENERAL_PROTECTION,    $u16 0x08, $u8 0x0, IST_ATTR_PRESENT | IST_ATTR_DPL_KERNEL | IST_ATTR_TRAP_GATE, IDT);
    idt_set_entry(INTVEC_PAGE_FAULT,            $u16 0x08, $u8 0x0, IST_ATTR_PRESENT | IST_ATTR_DPL_KERNEL | IST_ATTR_TRAP_GATE, IDT);
    idt_flush(IDT_PTR);

    println("done init idt");
    return 0;
}

void idt_set_entry(u64 vector, u16 selector, u8 ist, u8 type_attr, IDTEntry* idt) {
    u64 stub_addr = ($u64* @interrupt_stub_table)[vector];
    idt[vector].offset_1     = $u16 (stub_addr & 0xffff);
    idt[vector].selector     = selector;
    idt[vector].ist          = ist & $u8 0x7;
    idt[vector].type_attr    = type_attr;
    idt[vector].offset_2     = $u16 ((stub_addr >> $u64 16) & 0xffff);
    idt[vector].offset_3     = $u32 ((stub_addr >> $u64 32) & 0xffffffff);
    idt[vector].zero         = $u32 0;
}

void idt_flush(IDTPointer* ptr) {
    asm!("movq {ptr}, %rax");
    asm!("lidt (%rax)");
}

void irq_register(u64 vector, u16 selector, u8 ist, u8 type_attr, fn<void(void*)> handler, void* data) {
    // should not register an already registered IRQ
    assert(vector < IRQ_HANDLER_AMT);
    assert(!IRQ_HANDLERS[vector].present);

    // register in IDT
    idt_set_entry(vector, selector, ist, type_attr, IDT);
    idt_flush(IDT_PTR);

    // add handler
    IRQ_HANDLERS[vector].present = 1;
    IRQ_HANDLERS[vector].handler = handler;
    IRQ_HANDLERS[vector].data = data;
}

void irq_register(u64 vector, fn<void(void*)> handler, void* data) {
    irq_register(
        vector, 
        $u16 0x08,
        $u8 0x0,
        IST_ATTR_PRESENT | IST_ATTR_DPL_KERNEL | IST_ATTR_INTERRUPT_GATE,
        handler,
        data
    );
}

//this should save context to current active process kernel trapframe
//pass that as argument to dedicated interrupt handler. 
void interrupt_handler() {
    //cpu will have pushed these things onto the stack:
    // SS            : from user mode only
    // %rsp          : from user mode only
    // RFLAGS
    // CS
    // %rip
    // error code    : if interrupt doesn't push this itself, this should be 0
    // int_vec       : pushed by interrupt entry stub
    
    asm!(".global interrupt_handler_entry");
    asm!("interrupt_handler_entry:");

    //check if we are coming from kernel mode
    //we know that at least this is on the stack:
    // RFLAGS
    // CS
    // %rip
    // error code  
    // int_vec    
    asm!("pushq %rax");             // save %rax
    asm!("movq 32(%rsp), %rax");    // CS should be at +32 after pushing %rax
    asm!("test $3, %al");           // mask out 0b11
    asm!("jnz .interrupt_from_user"); 
    
    //if we're coming from kernel mode, redo the things that are pushed
    //so we can handle it as if we came from user mode
    asm!("pushq $0x10");            // SS               216
    asm!("lea 56(%rsp), %rax");     // there are 7 things pushed after the execution %rsp
    asm!("pushq %rax");             // %rsp             208
    asm!("pushq 56(%rsp)");         // RFLAGS           200
    asm!("pushq 56(%rsp)");         // CS               192
    asm!("pushq 56(%rsp)");         // %rip             184
    asm!("pushq 56(%rsp)");         // error code       176
    asm!("pushq 56(%rsp)");         // int_vec          168
    asm!("movq 56(%rsp), %rax");    // restore %rax
    asm!("jmp .interrupt_trapframe_create");

    //coming from user mode
    asm!(".interrupt_from_user:");
    asm!("popq %rax");              // restore %rax
    asm!("swapgs");                 // swap to kernel GS 

    //create trapframe
    asm!(".interrupt_trapframe_create:");
    asm!("sub $168, %rsp");
    
    asm!("movq %rax,  0(%rsp)");
    asm!("movq %rbx,  8(%rsp)");
    asm!("movq %rcx,  16(%rsp)");
    asm!("movq %rdx,  24(%rsp)");
    asm!("movq %rsi,  32(%rsp)");
    asm!("movq %rdi,  40(%rsp)");
    asm!("movq %rbp,  48(%rsp)");
    asm!("movq 208(%rsp), %rax");
    asm!("movq %rax,  56(%rsp)");
    asm!("movq %r8,   64(%rsp)");
    asm!("movq %r9,   72(%rsp)");
    asm!("movq %r10,  80(%rsp)");
    asm!("movq %r11,  88(%rsp)");
    asm!("movq %r12,  96(%rsp)");
    asm!("movq %r13,  104(%rsp)");
    asm!("movq %r14,  112(%rsp)");
    asm!("movq %r15,  120(%rsp)");
    asm!("movq 184(%rsp), %rax");
    asm!("movq %rax,  128(%rsp)");
    asm!("movq 200(%rsp), %rax");
    asm!("movq %rax,  136(%rsp)");
    asm!("mov %cr3, %rax");
    asm!("movq %rax,  144(%rsp)");
    asm!("movq 192(%rsp), %rax");
    asm!("movq %rax,  152(%rsp)");
    asm!("movq 216(%rsp), %rax");
    asm!("movq %rax,  160(%rsp)");

    //swap to kernel pagetable (need to do this after we save old pagetable)
    asm!("movq %gs:0, %rax");       
    asm!("mov %rax, %cr3");

    //gather arguments for high level interrupt handler
    asm!("movq %rsp, %rax");        //%rax now holds trapframe base
    asm!("movq 168(%rsp), %rbx");   //%rbx now holds int_vec
    asm!("movq 176(%rsp), %rcx");   //%rcx now holds error_code

    //go to higher level interrupt disambiguator
    asm!("pushq %rax");         // trapframe* tf
    asm!("pushq %rbx");         // u64 int_vec
    asm!("pushq %rcx");         // u64 error_code
    asm!("call interrupt_handler_disambiguator");

    //disambiguator should not return
    panic("interrupt_handler() : should not be here");
}

export void interrupt_handler_disambiguator(trapframe* tf, u64 int_vec, u64 error_code) {
    // send EOI
    // if interrupts were disabled, this shouldn't enable interrupts? 
    // before jumping to interrupt handler, CPU should've cleared interrupt in RFLAGS which this doesn't modify
    if(int_vec < 0x30) {
        if(int_vec >= 0x28) {
            //send EOI to slave 
            outb($u16 0xA0, $u8 0x20);
        }
        //send EOI to master
        outb($u16 0x20, $u8 0x20);
    }
    else {
        apic_write_reg(APIC_REGISTER_EOI, $u32 0);
    }

    // call handler
    if(int_vec < 0x20) {
        if(int_vec == INTVEC_GENERAL_PROTECTION) general_protection_fault_handler(tf, error_code);
        if(int_vec == INTVEC_PAGE_FAULT) page_fault_handler(tf, error_code);
        panic("interrupt_handler_disambiguator() : should not be here");
    }
    else {
        assert(IRQ_HANDLERS[int_vec].present);
        IRQ_HANDLERS[int_vec].handler#(IRQ_HANDLERS[int_vec].data);
    }
    
    // go to scheduler
    scheduler(tf);
}

//can trigger when you dereference a non-canonical address (for example 0x0f00000000000000)
void general_protection_fault_handler(trapframe* tf, u64 error_code) {
    if(tf->cs & 0x03) { //user mode
        asm!("cli");
        cout << "user mode general protection fault handler\n";

        //terminate the offending process
        pid_t pid = get_cur_pid();
        kill_process(pid, 1);

        //don't resume process we just killed
        scheduler();
    }
    else {              //kernel mode
        cout << "KERNEL MODE GENERAL PROTECTION FAULT!!!\n";
        cout << "ERROR CODE : " << $void* error_code << "\n";
        u64 cr2;
        asm!("mov %cr2, %rax");
        asm!("movq %rax, {cr2}");
        cout << "CR2 : " << ($void* cr2) << "\n";
        cout << "ACTIVE PROCESS : " << get_cur_pid() << "\n";
        print_trapframe(tf);
        panic("KERNEL MODE GENERAL PROTECTION FAULT!!!");
    }
}

void page_fault_handler(trapframe* tf, u64 error_code) {
    if(tf->cs & 0x03) { //user mode
        //disable interrupts
        asm!("cli");    
        cout << "user mode page fault handler\n";

        cout << "error code : " << $void* error_code << "\n";
        cout << "active process : " << get_cur_pid() << "\n";
        u64 cr2;
        asm!("mov %cr2, %rax");
        asm!("movq %rax, {cr2}");
        cout << "CR2 : " << ($void* cr2) << "\n";
        print_trapframe(tf);

        //terminate the offending process
        pid_t pid = get_cur_pid();
        kill_process(pid, 1);

        //don't resume process we just killed
        scheduler();
    }
    else {              //kernel mode
        cout << "KERNEL MODE PAGE FAULT!!!\n";
        cout << "ERROR CODE : " << $void* error_code << "\n";
        u64 cr2;
        asm!("mov %cr2, %rax");
        asm!("movq %rax, {cr2}");
        cout << "CR2 : " << ($void* cr2) << "\n";
        cout << "ACTIVE PROCESS : " << get_cur_pid() << "\n";
        print_trapframe(tf);
        panic("KERNEL MODE PAGE FAULT!!!");
    }
}
