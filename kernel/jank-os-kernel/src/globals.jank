#global_node BOOTINFO;
#global_node SYSCALL;
#global_node PS2;
#global_node VGA [BOOTINFO];
#global_node SERIAL [BOOTINFO];
#global_node PMA [SERIAL];
#global_node PAGING [SERIAL, PMA];
#global_node MALLOC [PMA, PAGING];
#global_node PRINTSTREAM [MALLOC, SERIAL];
#global_node KB [MALLOC];

typedef u64 pte_t;
typedef pte_t* pagetable_t;

//bootinfo struct constructed by the bootloader
[BOOTINFO] BootInfo* bootinfo = $BootInfo* BOOTBOOT_INFO;

struct BootInfo {
    u8[4]   magic;          // 'BOOT' magic
    
    u64     fb_base;        // physical base address
    u32     fb_size;        
    u32     fb_width;       
    u32     fb_height;
    u32     fb_ppsl;        // pixels per scan line, can be greater than width

    u64     rsdp_phys;

    // usage : MMapEnt2 *mmap_ent = &bootinfo.mmap; mmap_ent ++;
    u32     mmap_entries;   // mmap entry count
    MMapEnt mmap;       
}

struct MMapEnt {
    u64 base;
    u64 size;
    u32 type;
}

struct GSData {
    pagetable_t kernel_pt;              //0
    void* saved_stack;                  //8 : for saving the process stack during syscalls
    u64 cur_proc_kstack_top;            //16 : set in the scheduler
}

[__GLOBAL_FIRST__] u64 PAGE_SIZE    = $u64 0x001000;
[__GLOBAL_FIRST__] u64 HUGEPG_SIZE  = $u64 0x200000;

// -- MEMORY LAYOUT --
//process kstack layout
//by kstack, I mean a dedicated stack + trapframe combo, all in upper half memory
//each process gets its own kstack for use in context switching and syscalls
//kstacks should be mapped to the same vaddr in both kernel_pt and user_pt
//this layout is relative to the kstack bottom
[__GLOBAL_FIRST__] u64 KSTACK_SIZE          = 0x0000000000008000;
[__GLOBAL_FIRST__] u64 KSTACK_TRAPFRAME     = 0x0000000000007000;
[__GLOBAL_FIRST__] u64 KSTACK_TOP           = 0x0000000000007000;
[__GLOBAL_FIRST__] u64 KSTACK_BOTTOM        = 0x0000000000001000;
[__GLOBAL_FIRST__] u64 KSTACK_GUARD_PAGE    = 0x0000000000000000;

//kernel layout
[__GLOBAL_FIRST__] u64 KSTACK_AREA_BOTTOM   = 0xffffffff00000000;   //area to map kstacks
[__GLOBAL_FIRST__] u64 KSTACK_AREA_TOP      = 0xfffffffff0000000;

[__GLOBAL_FIRST__] u64 KERNEL_DATA_BOTTOM   = 0xfffffffff7000000;
[__GLOBAL_FIRST__] u64 GSDATA_PAGE          = 0xfffffffff7000000;   // holds the GSData struct
[__GLOBAL_FIRST__] u64 GDT_PAGE             = 0xfffffffff7001000;
[__GLOBAL_FIRST__] u64 IDT_PAGE             = 0xfffffffff7002000;
[__GLOBAL_FIRST__] u64 TSS_PAGE             = 0xfffffffff7003000;
[__GLOBAL_FIRST__] u64 KERNEL_DATA_TOP      = 0xfffffffff7004000;

[__GLOBAL_FIRST__] u64 BOOTBOOT_FB          = 0xfffffffffc000000;   // frame buffer virtual address
[__GLOBAL_FIRST__] u64 BOOTBOOT_INFO        = 0xffffffffff000000;   // bootboot struct virtual address
[__GLOBAL_FIRST__] u64 BOOTBOOT_CORE        = 0xffffffffff001000;   // kernel code start
[__GLOBAL_FIRST__] u64 BOOTBOOT_STACK_TOP   = 0x0000000000000000;   // initial kernel stack

//userspace layout
//for reference, top of userspace is          0x00007fffffffffff
//kernel will be mapped above userspace top
[__GLOBAL_FIRST__] u64 USER_STACK_TOP       = 0x00007ffffff00000;
[__GLOBAL_FIRST__] u64 USER_STACK_BOTTOM    = 0x00007fffffef0000;   //64 KB
[__GLOBAL_FIRST__] u64 USER_GUARD_PAGE      = 0x00007fffffeef000;
[__GLOBAL_FIRST__] u64 USER_HEAP_TOP        = 0x0000700000000000;
[__GLOBAL_FIRST__] u64 USER_HEAP_BOTTOM     = 0x0000100000000000;


